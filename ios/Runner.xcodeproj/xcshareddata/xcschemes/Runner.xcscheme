   <ArchiveAction
      buildConfiguration = "Release"
      revealArchiveInOrganizer = "YES">
      <PostActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Materialize archived app"
               scriptText = "set -e&#10;# The Strip Finder metadata build phase signs the app outside iCloud via a symlink.&#10;# exportArchive ignores that symlink, so replace it with the real bundle.&#10;# Organizer reads the archive plist, which can stay on the previous bundle id.&#10;app=&quot;${ARCHIVE_PRODUCTS_PATH:-}/Applications/Runner.app&quot;&#10;archive=&quot;${ARCHIVE_PATH:-}&quot;&#10;if [ ! -e &quot;$app&quot; ] &amp;&amp; [ -n &quot;$archive&quot; ]; then&#10;  app=&quot;${archive}/Products/Applications/Runner.app&quot;&#10;fi&#10;if [ -z &quot;$archive&quot; ] &amp;&amp; [ -n &quot;${ARCHIVE_PRODUCTS_PATH:-}&quot; ]; then&#10;  archive=&quot;$(cd &quot;${ARCHIVE_PRODUCTS_PATH}/..&quot; &amp;&amp; pwd)&quot;&#10;fi&#10;if [ -L &quot;$app&quot; ]; then&#10;  target=&quot;$(readlink &quot;$app&quot;)&quot;&#10;  rm -f &quot;$app&quot;&#10;  /usr/bin/ditto --norsrc &quot;$target&quot; &quot;$app&quot;&#10;  /usr/bin/xattr -cr &quot;$app&quot;&#10;fi&#10;if [ -f &quot;$app/Info.plist&quot; ] &amp;&amp; [ -f &quot;$archive/Info.plist&quot; ]; then&#10;  bid=&quot;$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' &quot;$app/Info.plist&quot;)&quot;&#10;  ver=&quot;$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' &quot;$app/Info.plist&quot;)&quot;&#10;  bld=&quot;$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' &quot;$app/Info.plist&quot;)&quot;&#10;  /usr/libexec/PlistBuddy -c &quot;Set :ApplicationProperties:CFBundleIdentifier $bid&quot; &quot;$archive/Info.plist&quot;&#10;  /usr/libexec/PlistBuddy -c &quot;Set :ApplicationProperties:CFBundleShortVersionString $ver&quot; &quot;$archive/Info.plist&quot;&#10;  /usr/libexec/PlistBuddy -c &quot;Set :ApplicationProperties:CFBundleVersion $bld&quot; &quot;$archive/Info.plist&quot;&#10;fi&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "97C146ED1CF9000F007C117D"
                     BuildableName = "Runner.app"
                     BlueprintName = "Runner"
                     ReferencedContainer = "container:Runner.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
   </ArchiveAction>
</Scheme>
