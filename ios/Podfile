require 'fileutils'

# Define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Keep Flutter's build/ outside iCloud Documents. Finder stamps metadata onto
# products written under Documents, and codesign then fails with
# "resource fork, Finder information, or similar detritus not allowed".
project_root = File.expand_path('..', __FILE__)
build_path = File.join(project_root, 'build')
external_build = File.expand_path('~/Library/Developer/heraj-meem-ios/flutter-build')
if File.symlink?(build_path)
  # ok
elsif File.directory?(build_path) && project_root.include?('/Documents/')
  FileUtils.mkdir_p(external_build)
  system('rsync', '-a', "#{build_path}/", "#{external_build}/")
  FileUtils.rm_rf(build_path)
  File.symlink(external_build, build_path)
elsif !File.exist?(build_path)
  FileUtils.mkdir_p(external_build)
  File.symlink(external_build, build_path)
end

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  # If you need modular headers for some pods:
  # use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # The repo lives in iCloud Documents. Finder stamps metadata onto products
  # under build/, and codesign then fails with "resource fork, Finder
  # information, or similar detritus not allowed". Strip those attrs on each
  # pod product before Xcode signs it.
  strip_pods_name = 'Strip iCloud xattrs'
  strip_pods_script = <<~'SCRIPT'
    set -e
    app="${CODESIGNING_FOLDER_PATH}"
    if [ -e "${app}" ]; then
      /usr/bin/xattr -cr "${app}" || true
    fi
  SCRIPT

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # 👇 Ensure every pod target uses at least iOS 15.0
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end

    existing = target.shell_script_build_phases.find { |item| item.name == strip_pods_name }
    if existing
      target.build_phases.delete(existing)
    end
    phase = target.new_shell_script_build_phase(strip_pods_name)
    phase.shell_script = strip_pods_script
    phase.always_out_of_date = '1'
  end

  # Keep this after CocoaPods' embed/copy phases so the signed app is complete.
  strip_name = 'Strip Finder metadata'
  installer.aggregate_targets.map(&:user_project).uniq.each do |user_project|
    user_project.native_targets.each do |target|
      phase = target.shell_script_build_phases.find { |item| item.name == strip_name }
      next if phase.nil?

      target.build_phases.delete(phase)
      target.build_phases << phase
    end
    user_project.save
  end
end
